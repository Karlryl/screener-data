# Preserve this policy file itself byte-for-byte.
/.gitattributes -text

/lib/early-detection.js text eol=lf
/protocol/early-detection/** text eol=lf
/reports/early-detection/** text eol=lf
/research/early-detection-v4/** text eol=lf
/scripts/early-detection-*.py text eol=lf
/scripts/early-detection-audit.js text eol=lf
/scripts/early-detection-confirmatory.py text eol=lf
/tests/early-detection*.test.js text eol=lf
/tests/early-detection-confirmatory.test.js text eol=lf
/tests/early-detection.test.js text eol=lf
/src/scoring/** text eol=lf

# Studie 2.0.0 (Verfassung vom 2026-08-16). Same LF pinning as the early-detection
# tree above: these paths were unpinned until Tag 936, so a Windows checkout could
# have produced different bytes than CI - and E1+ will hash some of them.
/lib/studie-*.js text eol=lf
/reports/studie/** text eol=lf
/research/studie/** text eol=lf
/scripts/studie-*.js text eol=lf
/scripts/studie-*.py text eol=lf
/tests/studie-*.test.js text eol=lf

# Immutable generated evidence: preserve the exact sealed bytes in Git.
/reports/early-detection/prospective-listing-snapshot-verification-2026-08-10-v2.json -text
/reports/early-detection/prospective-listing-snapshot-2026-08-11-v3.json -text
/reports/early-detection/prospective-listing-snapshot-verification-2026-08-11-v3.json -text
/reports/early-detection/prospective-listing-panel-2026-08-11-v3.json -text
# R13/R12b evidence of the 2.0.0 constitution: sealed byte-for-byte, never re-edited.
# -text also removes the eol normalisation that made these two show up as phantom "M"
# on a Windows checkout (index stat size from the pre-normalisation blob).
/protocol/early-detection/2.0.0/provenance-closure.json -text
/protocol/early-detection/2.0.0/data-contract.json -text
